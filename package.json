{
  "name": "junrei",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "postinstall": "void prepare",
    "data:sync": "python -m sync.sync",
    "data:export": "python -m sync.export",
    "data:import": "void db execute --file data/d1-import.sql",
    "data": "pnpm data:sync && pnpm data:export && pnpm data:import",
    "enrich:places": "python -m sync.places",
    "enrich:bgm": "python -m sync.bgm",
    "enrich:geocheck": "python -m sync.geocheck",
    "enrich:notes": "python -m sync.notes",
    "enrich:translate": "python -m sync.translate",
    "enrich:report": "python -m sync.enrich_report",
    "enrich": "pnpm enrich:places && pnpm enrich:bgm && pnpm enrich:geocheck"
  },
  "dependencies": {
    "@jannchie/icons": "0.12.0",
    "@jannchie/icons-vue": "0.12.0",
    "hono": "^4.11.9",
    "maplibre-gl": "^5.9.0",
    "vue": "^3.5.30",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@void/vue": "1.2.1",
    "sharp": "0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.0.10",
    "void": "1.2.1"
  }
}
